<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- GPS-калибровка дистанции (V9.15): чистый GPS-приёмник, только для
         измерения метров при калибровке. Координаты не сохраняются и не
         отправляются. Запрашивается точечно, не при старте. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".StepCoreApp"
        android:label="StepCore"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.StepCore"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Vault. excludeFromRecents: экран не остаётся в списке задач.
             Превью в списке задач запрещено кодом; полный запрет
             скриншотов - настройка на вкладке «Защита».

             СВОЙ ПРОЦЕСС.
             Падение внутри тайника роняло счёт шагов: StepService жил в
             том же процессе, и краш в заметках убивал сервис вместе с
             несохранёнными шагами. Шаги нельзя собрать задним числом,
             заметки - можно переоткрыть.

             Разделение ничего не разорвало: модуль не обращается к ядру
             ни одной строкой (проверяется стражем границы), своя база,
             свои файлы, свои настройки.

             ЦЕНА. Ключ живёт в памяти процесса, а этот процесс не
             защищён передним сервисом, как главный. Система вправе
             выгрузить его раньше, чем истечёт льгота пароля - об этом
             честно сказано на экране «Защита». -->
        <activity
            android:name=".vault.VaultActivity"
            android:process=":vault"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name=".StepService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- v437. Explicit PendingIntent target Activity Recognition. -->
        <receiver
            android:name=".ActivityContextReceiver"
            android:exported="false" />

        <activity
            android:name=".TimelineActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".StatsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".survival.SurvivalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".survival.RadarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DayProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SynxActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".SplitActivity" android:exported="false" />
        <activity android:name=".SlopeCalActivity" android:exported="false" />
        <activity android:name=".PermissionsActivity" android:exported="false" />

    </application>
</manifest>
