<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИСТОРИЯ"
                android:textColor="@color/text_main"
                android:textSize="33sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <com.vasil.stepcore.DoodleSceneView
            android:id="@+id/doodleHeader"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/filter7" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="7д" />
                <Button android:id="@+id/filter30" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="30д" />
                <Button android:id="@+id/filter365" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Год" />
                <Button android:id="@+id/filterAll" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Всё" />
            </LinearLayout>

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/daysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button android:id="@+id/copyButton" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Копия" />
                <Button android:id="@+id/exportCsvButton" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="CSV" />
            </LinearLayout>

            <!-- v291. Раньше здесь стояли две кнопки «JSON» и «Импорт»
                 рядом с «CSV», и по названиям было не понять, что из
                 этого полный бэкап, а что выгрузка таблицы. Теперь один
                 вход с тем же диалогом, что в SYNX: одно действие -
                 одно понятное имя. -->
            <TextView
                android:id="@+id/backupPlate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="💾  Сохранить и восстановить данные"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Полный файл со всеми данными: шаги, калории, журнал, корпус обучения, сессии с твоими ответами и калибровки. Кнопка «CSV» выше — это просто таблица дней для просмотра, восстановить из неё нельзя."
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удаление всей истории"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <EditText
                android:id="@+id/deleteConfirmInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Введи: УДАЛИТЬ ДАННЫЕ"
                android:inputType="text" />

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/copySelectedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:text="Копировать выбранные (0)"
        android:visibility="gone" />

</FrameLayout>
