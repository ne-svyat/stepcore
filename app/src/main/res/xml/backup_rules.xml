<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11-30. Vault не покидает устройство через системный бэкап:
     иначе пароль обходился бы через чужой телефон. -->
<full-backup-content>
    <exclude domain="file" path="vault/" />
    <exclude domain="database" path="vault.db" />
    <exclude domain="database" path="vault.db-shm" />
    <exclude domain="database" path="vault.db-wal" />
    <exclude domain="sharedpref" path="vault.xml" />
</full-backup-content>
