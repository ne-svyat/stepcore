<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Два раздела: облачный бэкап и прямой перенос на новый
     телефон. Vault исключён из обоих. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="vault.db" />
        <exclude domain="database" path="vault.db-shm" />
        <exclude domain="database" path="vault.db-wal" />
        <exclude domain="sharedpref" path="vault.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault/" />
        <exclude domain="database" path="vault.db" />
        <exclude domain="database" path="vault.db-shm" />
        <exclude domain="database" path="vault.db-wal" />
        <exclude domain="sharedpref" path="vault.xml" />
    </device-transfer>
</data-extraction-rules>
