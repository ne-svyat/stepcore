<?xml version="1.0" encoding="utf-8"?>
<!-- Закрытие экрана: уходит вперёд, к смотрящему, и гаснет. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="170" />
    <scale
        android:fromXScale="1.0" android:toXScale="0.97"
        android:fromYScale="1.0" android:toYScale="0.97"
        android:pivotX="50%p" android:pivotY="55%p"
        android:duration="190" />
</set>
